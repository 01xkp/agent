# API 协议：openai 或 claude。
API_TYPE=openai

# OpenAI 兼容协议配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Claude Messages API 配置。Claude 官方地址通常不需要 /v1。
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com

# 使用当前接口可访问的 1～3 个模型名，以英文逗号分隔。
MODEL_IDS=gpt-4o-mini

# 按模型供应商当天官方价格填写，每项单位为“每百万 Token”。
MODEL_PRICING_JSON={}

TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=2048
# 首 Token 超过 20 秒仍未出现时停止等待，避免慢模型让页面长期无响应。
FIRST_TOKEN_TIMEOUT_MS=20000
# 已经开始输出后，单次完整生成最多等待 90 秒。
MODEL_TIMEOUT_MS=90000
# 发送给模型的历史消息上限；一轮对话通常包含 user 和 assistant 两条消息。
CHAT_HISTORY_MAX_MESSAGES=8
# 历史消息总字符上限，越大越容易增加 Token、延迟和费用。
CHAT_HISTORY_MAX_CHARACTERS=12000
# 普通聊天总尝试次数；已经输出 Token 后不会重试。
CHAT_MAX_ATTEMPTS=2
# 第一次重试前等待时间，后续按次数递增。
CHAT_RETRY_BASE_DELAY_MS=500
EVAL_CONCURRENCY=1
PORT=3000

# 没有 API Key 时设为 true，可先完成安装、CLI、测试和评测流程演练。
MOCK_MODE=true

# 部分 CloudBase 托管运行时会注入环境与临时令牌；容器云托管通常需要在
# 服务设置中配置环境 ID 和专用最小权限腾讯云密钥。
# 本地只想运行 Mock 时可全部留空，数据库会自动降级为未启用。
CLOUDBASE_ENV_ID=
CLOUDBASE_COLLECTION=ai_chat_runs
CLOUDBASE_REGION=ap-shanghai

# 之前使用的 Agnes 配置示例；需要切回时复制到 .env 并填写密钥。
# API_TYPE=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
# MODEL_IDS=agnes-2.0-flash
# MODEL_PRICING_JSON={"agnes-2.0-flash":{"inputPerMillion":0,"outputPerMillion":0}}
# TEMPERATURE=0.2
# MAX_OUTPUT_TOKENS=2048
# MOCK_MODE=false
